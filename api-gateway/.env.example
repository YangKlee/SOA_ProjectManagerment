CONSUL_URL=http://host.docker.internal:8500
CONSUL_REFRESH_SECONDS=3
CONSUL_TIMEOUT_SECONDS=2
CONSUL_STALE_TTL_SECONDS=15
# CONSUL_TOKEN=

# Exact browser origins, comma-separated; no trailing slash or wildcard.
# An explicitly empty value disables cross-origin access. Recreate Gateway after edits.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
