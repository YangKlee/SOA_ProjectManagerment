JWT_SIGNING_KEY=replace-with-a-secret-shared-jwt-signing-key

# Registry registration is enabled explicitly for local servers.
CONSUL_AUTO_REGISTER=false
CONSUL_URL=http://localhost:8500
CONSUL_SERVICE_NAME=topic-service
CONSUL_SERVICE_ID=topic-service-8004
CONSUL_SERVICE_ADDRESS=host.docker.internal
CONSUL_SERVICE_PORT=8004
CONSUL_HEALTH_CHECK_URL=http://host.docker.internal:8004/health/
CONSUL_TIMEOUT_SECONDS=3
# CONSUL_TOKEN=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal

# Academic reference validation: healthy instances from Consul by default.
ACADEMIC_DISCOVERY_ENABLED=true
ACADEMIC_TIMEOUT_SECONDS=2
# Used only when ACADEMIC_DISCOVERY_ENABLED=false (local development).
ACADEMIC_BASE_URL=http://localhost:8002

# Response names use the same ACADEMIC_* transport settings above.
# Shared internal credential; topic's current public academic calls still use JWT.
# Never expose this value to the frontend.
INTERNAL_SERVICE_TOKEN= "Y@ngKlee18072005"
