# Set this to exactly the same value configured for auth-service.
JWT_SIGNING_KEY=replace-with-a-secret-shared-jwt-signing-key

# Registry registration is enabled explicitly for local servers.
CONSUL_AUTO_REGISTER=false
CONSUL_URL=http://localhost:8500
CONSUL_SERVICE_NAME=academic-service
CONSUL_SERVICE_ID=academic-service-8002
CONSUL_SERVICE_ADDRESS=host.docker.internal
CONSUL_SERVICE_PORT=8002
CONSUL_HEALTH_CHECK_URL=http://host.docker.internal:8002/health/
CONSUL_TIMEOUT_SECONDS=3
# CONSUL_TOKEN=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal
