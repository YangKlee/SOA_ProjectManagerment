CONSUL_AUTO_REGISTER=true
CONSUL_URL=http://localhost:8500
CONSUL_SERVICE_NAME=auth-service
CONSUL_SERVICE_ID=auth-service-8001
CONSUL_SERVICE_ADDRESS=host.docker.internal
CONSUL_SERVICE_PORT=8001
CONSUL_HEALTH_CHECK_URL=http://host.docker.internal:8001/health/
# CONSUL_TOKEN=
# Set the same value in every service that validates auth-service access tokens.
JWT_SIGNING_KEY=replace-with-a-secret-shared-jwt-signing-key

ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal

# Internal identity name lookup; same generated secret in academic-service.
# Empty disables access. Supply via environment or untracked .env, never commit secrets.
DISPLAY_NAMES_SERVICE_TOKEN="YangKlee18072005"
